{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/downloads/flutter-macos-app.zip",
        "destination": "https://github.com/vteam-com/fPaint/releases/latest/download/fPaint-macos.zip",
        "type": 302
      },
      {
        "source": "/downloads/flutter-windows-app.zip",
        "destination": "https://github.com/vteam-com/fPaint/releases/latest/download/fPaint-windows.zip",
        "type": 302
      },
      {
        "source": "/downloads/flutter-linux-app.zip",
        "destination": "https://github.com/vteam-com/fPaint/releases/latest/download/fPaint-linux.tar.gz",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "releases": {
      "retained": 3
    }
  }
}
